# -----------------------------------------------------------------------------
# Copie para .env.local e preencha. NUNCA versione valores reais.
# Variáveis NEXT_PUBLIC_* são expostas ao navegador: não coloque segredos nelas.
# -----------------------------------------------------------------------------

# URL pública do site (usada em links de e-mail e redirects de autenticação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Ignora RLS: use apenas em webhooks/rotinas internas.
SUPABASE_SERVICE_ROLE_KEY=

# Mapas (Fase 2). Padrão: tiles OpenStreetMap — veja docs/PLANO.md sobre a política de uso.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Geocodificação (Fase 2): nominatim | mapbox
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=plataforma-paineis/0.1 (contato@seudominio.com.br)
MAPBOX_ACCESS_TOKEN=

# Mercado Pago (Fase 4) — credenciais de teste primeiro
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail transacional (Fase 5)
RESEND_API_KEY=
EMAIL_FROM="Plataforma de Painéis <nao-responda@seudominio.com.br>"

# Rotinas agendadas (expiração de reservas temporárias etc.)
CRON_SECRET=

# Monitoramento (opcional)
SENTRY_DSN=
